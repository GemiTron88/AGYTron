{
  "name": "@gemitron/agy-tron",
  "version": "1.0.0",
  "description": "AGYTron — Global AGY AI Creative Director, ToS-Safe Host-Inversion SDK, Dual Cloud/Local GemiMCP Bridge, and Premium Control Studio for all 7 TronCS Desktop Creative Suite apps (PhotoTron, FilmTron, AfterTron, GemiMotion, FigTron, LightTron, ScaleTron) and all 7 Android ARM64 Mobile Companions (PhotoTron-Mobile, FilmTron-Mobile, AfterTron-Mobile, GemiMotion-Mobile, FigTron-Mobile, LightTron-Mobile, ScaleTron-Mobile)",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./llm-providers": "./src/llm-providers.mjs",
    "./suite-directors": "./src/suite-directors.mjs",
    "./mcp-bridge": "./src/mcp-bridge.mjs",
    "./fleet-router": "./src/fleet-router.mjs",
    "./ui": "./ui/TronAgyControlCenter.tsx"
  },
  "bin": {
    "agy-tron": "./bin/tron-agy.mjs",
    "tron-agy": "./bin/tron-agy.mjs",
    "agy-node-daemon": "./bin/agy-node-daemon.mjs"
  },
  "scripts": {
    "test": "node --test test/tron-agy.test.mjs test/llm-providers.test.mjs test/suite-directors.test.mjs test/mcp-bridge.test.mjs test/agy-wiring-e2e.test.mjs",
    "cli": "node ./bin/tron-agy.mjs",
    "daemon:win-local": "node ./bin/agy-node-daemon.mjs --node-id win-local --port 18220",
    "daemon:mac-local": "node ./bin/agy-node-daemon.mjs --node-id mac-local --port 18220",
    "daemon:vps-01": "node ./bin/agy-node-daemon.mjs --node-id vps-01 --port 18220",
    "daemon:vps-02": "node ./bin/agy-node-daemon.mjs --node-id vps-02 --port 18220 --hub https://mcp.gemitron.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GemiTron88/AGYTron.git"
  },
